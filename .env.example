# Application
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/smartbin

# MQTT
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Authentication
NEXTAUTH_SECRET=change-this-in-production
NEXTAUTH_URL=http://localhost:3000

JWT_SECRET=change-this-in-production

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TARGET_USER_ID=

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Smart Bin
BIN_OFFLINE_AFTER_SECONDS=300